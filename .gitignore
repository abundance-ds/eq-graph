# Local pipeline work and active run output.
# artefacts/, pilot/, and scale/ hold local run output. Only the listed subtrees are tracked;
# they are frozen with the release. Add a new file there with `git add -f`.
/artefacts/
/pilot/*
!/pilot/README.md
!/pilot/ontology-development-v4/
/pilot/ontology-development-v4/aggregate-validity-v5/traces/
/pilot/ontology-development-v4/aggregate-validity-v5/__pycache__/
/scale/*
!/scale/README.md
!/scale/protocol-2.0/
/scale/protocol-2.0/*
!/scale/protocol-2.0/*.csv
!/scale/protocol-2.0/*.json
!/scale/protocol-2.0/profile-qa-v1/
