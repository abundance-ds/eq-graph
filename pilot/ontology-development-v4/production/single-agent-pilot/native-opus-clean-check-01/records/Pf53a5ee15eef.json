        ]
      },
      {
        "type": "Finding",
        "id": "F3",
        "study_id": "S1",
        "part_id": "PT1",
        "statement": "The existing Bahasa translations for 'pain' ('kesakitan', 'nyeri') and 'worried' ('cemas') were judged not comprehensible or not age appropriate, so 'rasa sakit' (with 'pada tubuh' added for discomfort) and 'khawatir' were adopted, breaking consistency with the EQ-5D-Y-3L Bahasa version.",
        "about": [
          "IU1",
          "C3"
        ],
        "values": [],
        "source": [
          "scale/protocol-2.0/fulltext-preparation-v2/markdown/Pf53a5ee15eef.md"
        ]
      },
      {
        "type": "Finding",
        "id": "F4",
        "study_id": "S1",
        "part_id": "PT1",
        "statement": "Translating the level 3 qualifier 'some' was difficult; 'cukup' was chosen over 'sedikit', 'beberapa', 'setengah' and 'kurang lebih' to align with level 3 of the EQ-5D-5L, although no back translator rendered 'cukup' as 'some'.",
        "about": [
          "IU1",
          "C1"
        ],
        "values": [],
        "source": [
