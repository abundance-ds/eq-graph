        "type": "Interpretation",
        "id": "IN1",
        "study_id": "S1",
        "part_id": null,
        "statement": "The EQ-HWB-9 is broadly acceptable and feasible as a proxy measure for the health and wellbeing of community-dwelling people with dementia when completed by informal caregivers.",
        "finding_ids": [
          "F1",
          "F2"
        ],
        "source": [
