        "type": "Interpretation",
        "id": "IN3",
        "study_id": "S1",
        "part_id": null,
        "statement": "Proxy reporting of non-observable domains relies on interpretation of non-verbal cues and creates response uncertainty and potential bias, so clear instructions and guidance should accompany proxy measures.",
        "finding_ids": [
          "F7",
          "F3",
          "F4"
        ],
        "source": [
