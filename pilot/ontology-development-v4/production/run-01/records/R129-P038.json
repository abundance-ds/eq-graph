          "direction": "lower by 15.8 percentage points",
          "uncertainty": "p < 0.001"
        },
        {
          "reported_value": "0.7",
          "unit": "% floor",
          "denominator": "analyzed respondents",
          "time": "2024 survey",
          "subgroup": "PROMIS-16 physical function",
          "comparator": "EQ-5D-5L mobility: 0.4%",
          "direction": "higher by 0.3 percentage points",
          "uncertainty": "p < 0.001"
        },
        {
          "reported_value": "1.5",
          "unit": "% floor",
          "denominator": "analyzed respondents",
          "time": "2024 survey",
          "subgroup": "PROMIS-16 anxiety/depression construct",
