      "id": "f1",
      "study_id": "s1",
      "part_id": "part1",
      "statement": "Within matched constructs, PROMIS-16 had significantly lower ceiling percentages than EQ-5D-5L. Its physical-function floor was higher than the EQ-5D-5L mobility floor, but its combined anxiety/depression floor was lower than the corresponding EQ-5D-5L floor.",
      "about": [
        "o1",
        "iu1",
        "iu2"
      ],
      "values": [
        {
          "reported_value": "64.6",
          "unit": "% ceiling",
          "denominator": "analyzed respondents",
          "time": "2024 survey",
          "subgroup": "PROMIS-16 physical function",
          "comparator": "EQ-5D-5L mobility: 79.9%",
          "direction": "lower by 15.3 percentage points",
          "uncertainty": "p < 0.001"
        },
        {
          "reported_value": "28.9",
          "unit": "% ceiling",
          "denominator": "analyzed respondents",
          "time": "2024 survey",
          "subgroup": "PROMIS-16 anxiety/depression construct",
