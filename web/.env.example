# Copy this file to .env and add the values. Do not commit .env.

NUXT_ANTHROPIC_API_KEY=sk-ant-...

NUXT_NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NUXT_NEO4J_USER=<username>
NUXT_NEO4J_PASSWORD=<password>
# Optional. Leave this empty to use the account's home database.
NUXT_NEO4J_DATABASE=
