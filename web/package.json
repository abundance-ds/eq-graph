{
  "name": "eq-graph-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:check": "tsx --env-file=.env scripts/check-database.ts",
    "db:local:up": "docker compose up -d",
    "db:local:down": "docker compose down",
    "db:local:migrate": "tsx scripts/migrate.ts",
    "db:local:seed": "tsx scripts/seed.ts",
    "db:local:reset": "tsx scripts/seed.ts --wipe"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/vue": "^2.0.0",
    "@observablehq/plot": "^0.6.17",
    "ai": "^5.0.0",
    "d3-format": "^3.1.2",
    "d3-time-format": "^4.1.0",
    "neo4j-driver": "^6.0.0",
    "nuxt": "^4.4.8",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/d3-format": "^3.0.4",
    "@types/d3-time-format": "^4.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vue-tsc": "^3.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
